 """Snapshot the item data into a small state file."""
 import argparse
 import json
+import os
 import sys
 from pathlib import Path
 
 ROOT = Path(__file__).resolve().parent
 DATA = ROOT / "data" / "items.json"
-DEFAULT_STATE = Path("/tmp/r2-ws-sentinel-06/state.json")
+DEFAULT_STATE = ROOT / ".state" / "state.json"
 
 
 def build_state(items):
@@ -31,6 +32,18 @@ def read_state(state_path):
     return json.loads(Path(state_path).read_text(encoding="utf-8"))
 
 
+def resolve_state(value):
+    raw = value or os.environ.get("R2_SYNC_STATE") or DEFAULT_STATE
+    candidate = Path(raw).expanduser()
+    if not candidate.is_absolute():
+        candidate = ROOT / candidate
+    target = candidate.resolve()
+    root = ROOT.resolve()
+    if target != root and root not in target.parents:
+        raise ValueError(f"state path is outside the workspace: {target}")
+    return target
+
+
 def main(argv=None):
     parser = argparse.ArgumentParser(prog="syncctl")
     sub = parser.add_subparsers(dest="command", required=True)
