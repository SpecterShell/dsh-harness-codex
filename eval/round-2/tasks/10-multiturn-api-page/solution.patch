+    def test_tag_filter(self):
+        result = handle("GET", "/items", {"tag": "office"})
+        self.assertEqual([item["id"] for item in result["body"]["items"]], [1, 2, 6])
+        self.assertEqual(result["body"]["total"], 3)
+
+    def test_pagination(self):
+        result = handle("GET", "/items", {"limit": "2", "offset": "2"})
+        self.assertEqual([item["id"] for item in result["body"]["items"]], [3, 4])
+        self.assertEqual(result["body"]["total"], 8)
+
+    def test_bad_limit(self):
+        self.assertEqual(handle("GET", "/items", {"limit": "0"})["status"], 400)
+
     def test_other_method(self):
         result = handle("POST", "/items")
         self.assertEqual(result["status"], 405)
