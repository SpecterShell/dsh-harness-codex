{
  "title": "orders-v2",
  "fields": {
    "order_id": {"type": "string", "pattern": "^ORD-[0-9]{4}$", "required": true},
    "currency": {"type": "string", "enum": ["EUR", "GBP", "USD"], "required": true},
    "quantity": {"type": "integer", "minimum": 1, "maximum": 1000, "required": true},
    "unit_price_cents": {"type": "integer", "minimum": 0, "required": true},
    "email": {"type": "string", "pattern": "^[^@]+@[^@]+$", "required": false}
  }
}
