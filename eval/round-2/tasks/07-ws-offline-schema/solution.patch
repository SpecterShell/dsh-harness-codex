diff --git a/src/validate.mjs b/src/validate.mjs
index e346fad..ebbe41e 100644
--- a/src/validate.mjs
+++ b/src/validate.mjs
@@ -1,5 +1,35 @@
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const schema = JSON.parse(
+  readFileSync(join(here, "..", "schema", "orders.schema.json"), "utf8"),
+);
+
+const INTEGER = /^-?\d+$/;
+
 export function validateRow(row) {
-  const fields = [];
-  if (!row.order_id) fields.push("order_id");
-  return fields;
+  const invalid = [];
+  for (const [name, rule] of Object.entries(schema.fields)) {
+    const raw = row[name];
+    const empty = raw === undefined || raw === "";
+    if (empty) {
+      if (rule.required) invalid.push(name);
+      continue;
+    }
+    if (rule.type === "integer") {
+      if (!INTEGER.test(raw)) {
+        invalid.push(name);
+        continue;
+      }
+      const value = Number(raw);
+      if (rule.minimum !== undefined && value < rule.minimum) invalid.push(name);
+      else if (rule.maximum !== undefined && value > rule.maximum) invalid.push(name);
+    } else if (rule.type === "string") {
+      if (rule.enum && !rule.enum.includes(raw)) invalid.push(name);
+      else if (rule.pattern && !new RegExp(rule.pattern).test(raw)) invalid.push(name);
+    }
+  }
+  return invalid;
 }
