diff --git a/packages/api/test/users.test.js b/packages/api/test/users.test.js
new file mode 100644
index 0000000..695fb12
--- /dev/null
+++ b/packages/api/test/users.test.js
@@ -0,0 +1,18 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+
+import { handle } from '../src/index.js'
+
+test('users route returns the user in the envelope', () => {
+  const response = handle('GET', '/users/2')
+  assert.equal(response.status, 200)
+  assert.deepEqual(response.body.data, { id: '2', name: 'Grace' })
+  assert.equal(response.body.error, null)
+})
+
+test('users route returns a 404 envelope for a missing user', () => {
+  const response = handle('GET', '/users/999')
+  assert.equal(response.status, 404)
+  assert.equal(response.body.data, null)
+  assert.equal(typeof response.body.error, 'string')
+})
