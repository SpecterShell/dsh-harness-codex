{
  "name": "dsh-harness-codex",
  "version": "0.1.0",
  "description": "Codex-style agent preset for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "SpecterShell",
  "homepage": "https://github.com/SpecterShell/dsh-harness-codex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpecterShell/dsh-harness-codex.git"
  },
  "bugs": {
    "url": "https://github.com/SpecterShell/dsh-harness-codex/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "codex",
    "agent-preset",
    "cordis",
    "plugin"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./exec": {
      "types": "./lib/exec/index.d.ts",
      "default": "./lib/exec/index.js"
    },
    "./plan": {
      "types": "./lib/plan.d.ts",
      "default": "./lib/plan.js"
    },
    "./image": {
      "types": "./lib/image.d.ts",
      "default": "./lib/image.js"
    },
    "./surface": {
      "types": "./lib/surface.d.ts",
      "default": "./lib/surface.js"
    },
    "./persona": {
      "types": "./lib/persona.d.ts",
      "default": "./lib/persona.js"
    },
    "./instructions": {
      "types": "./lib/instructions.d.ts",
      "default": "./lib/instructions.js"
    },
    "./freeform": {
      "types": "./lib/freeform/index.d.ts",
      "default": "./lib/freeform/index.js"
    },
    "./compaction": {
      "types": "./lib/compaction/index.d.ts",
      "default": "./lib/compaction/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "prompts",
    "assets",
    "NOTICE",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "test:proofs": "node --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "prepack": "pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.7"
  }
}
